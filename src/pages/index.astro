---
import Base from '../layouts/Base.astro';
import HowItWorks from '../components/HowItWorks.astro';
import { equipment } from '../data/equipment';
// Sections cloned from the Paul's Homemade (.com) homepage — "Seriously good fun"
// down through the flavour carousel, Paul's Difference, booking CTA and reviews.
// Images are placeholders (in /home-assets) to be replaced with our own pictures.
import homeSections from '../partials/home-sections.html?raw';
---

<Base>
  <!-- Hero -->
  <section class="relative bg-pauls-blue text-white overflow-hidden">
    <picture>
      <source srcset="/home-assets/home-hero.webp" type="image/webp" />
      <img src="/home-assets/home-hero.jpg" alt="Paul's Homemade ice cream tuk-tuk staffed and ready to serve at an event" width="1920" height="1384" class="absolute inset-0 w-full h-full object-cover" />
    </picture>
    <div class="absolute inset-0 bg-gradient-to-br from-pauls-blue/85 via-pauls-dark-blue/75 to-pauls-blue/85"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 md:py-36 text-center">
      <h1 class="text-4xl md:text-6xl leading-tight mb-4 !text-white [text-shadow:0_2px_12px_rgb(0_0_0_/_55%)]">
        Your big day,<br />scooped to perfection
      </h1>
      <p class="text-lg md:text-xl text-white/90 max-w-2xl mx-auto mb-8 [text-shadow:0_1px_8px_rgb(0_0_0_/_55%)]">
        Full-service ice cream catering for weddings, birthdays, corporate events and everything in between — across Johannesburg and beyond.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/book" class="bg-pauls-pink text-white px-8 py-3.5 rounded-full font-bold text-lg hover:opacity-90 transition-opacity shadow-lg">
          Get a Quote
        </a>
        <a href="/events" class="border-2 border-white/40 text-white px-8 py-3.5 rounded-full font-bold text-lg hover:bg-white/10 transition-colors">
          See Our Setups
        </a>
      </div>
    </div>
  </section>

  <!-- Equipment overview -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <p class="eyebrow">Equipment</p>
    <h2 class="text-3xl md:text-4xl text-center mb-4">What We Do</h2>
    <p class="text-center text-pauls-dark-blue/75 mb-12 max-w-xl mx-auto">Five ways to bring Paul's to your event</p>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {equipment.map(({ slug, name, blurb, icon }) => (
        <a href={`/events#${slug}`} class="group bg-white rounded-2xl p-8 shadow-sm hover:shadow-md transition-shadow text-center">
          <div class="text-4xl mb-4">{icon}</div>
          <h3 class="text-xl mb-2 group-hover:text-pauls-blue transition-colors">{name}</h3>
          <p class="text-pauls-dark-blue/75 text-sm">{blurb}</p>
        </a>
      ))}
      <a href="/book" class="group bg-pauls-blue text-white rounded-2xl p-8 shadow-sm hover:shadow-md transition-shadow text-center flex flex-col items-center justify-center">
        <div class="text-4xl mb-4">📝</div>
        <h3 class="text-xl mb-2 !text-white">Not sure which?</h3>
        <p class="text-white/80 text-sm">Tell us about your event and we'll recommend the right setup in your quote.</p>
      </a>
    </div>
  </section>

  <!-- How It Works -->
  <HowItWorks />

  <!-- ===== Cloned .com homepage sections: Seriously good fun → carousel → difference → booking → reviews ===== -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@splidejs/splide@4.1.4/dist/css/splide-core.min.css" integrity="sha384-UUMoBPww5zPuXpRJLHFTN+9x39lTnFOA9kj9q4HOVqv+aZH6G7jZwnXkrE5c18lX" crossorigin="anonymous" />
  <Fragment set:html={homeSections} />

  <!-- Splide carousel runtime + init. Exact versions pinned: the auto-scroll
       extension 0.5.x needs Splide 4 (with Splide 3.2.2 it threw on every load). -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/@splidejs/splide@4.1.4/dist/js/splide.min.js" integrity="sha384-RbYB5yr9jD1p+2OHlV3KzOBLAY48CbFsJ87bXEFYINGgOlQJNE4cEjTUf+Q2fygb" crossorigin="anonymous"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/@splidejs/splide-extension-auto-scroll@0.5.3/dist/js/splide-extension-auto-scroll.min.js" integrity="sha384-10Fh7FCq6vJI5Wuf0wv6nj9zcFJhfBWOYq8t0LXil6xFLu3GAviHPJhZPXAPl463" crossorigin="anonymous"></script>
  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      if (!window.Splide || !window.splide || !window.splide.Extensions) return;
      var splideElements = document.querySelectorAll('.splide');
      window.paulsCarousels = {};
      for (var i = 0; i < splideElements.length; i++) {
        window.paulsCarousels[splideElements[i].id] = new Splide(splideElements[i], {
          type: 'loop',
          autoWidth: true,
          height: 'auto',
          drag: 'free',
          arrows: false,
          pagination: false,
          label: 'Image Slider',
          reducedMotion: { speed: 0, rewindSpeed: 0, autoplay: 'pause' },
          autoScroll: { speed: 0.6, pauseOnHover: false, pauseOnFocus: false },
          breakpoints: {
            991: { autoScroll: { speed: 0.6, pauseOnHover: false, pauseOnFocus: false } },
            767: { autoScroll: { speed: 0.6, pauseOnHover: false, pauseOnFocus: false } }
          }
        }).mount(window.splide.Extensions);
      }
    });
  </script>

  <!-- Flavour cards: click/tap or Enter/Space on a card shows its details side
       (description, ingredients, allergens, certification); the X, Escape or the
       card again closes it. Cards with no published details do not open. Runs after
       the carousel init above, so the carousel's cloned cards are wired too. -->
  <style is:global>
    /* visible again at once on close (so focus can return to it), hidden only after the fade on open */
    .flavour-card .flavours-div:not(.back) { transition: opacity .3s ease, visibility 0s; }
    .flavour-card.is-open .flavours-div:not(.back) { opacity: 0; visibility: hidden; pointer-events: none; transition: opacity .3s ease, visibility 0s .3s; }
    .flavour-card.no-details .flavours-div { cursor: auto; }
    .flavour-card [role="button"]:focus-visible { outline: 3px solid #1d44c2; outline-offset: 3px; }
    .flavour-card .back { overflow-y: auto; }
  </style>
  <script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      var cards = document.querySelectorAll('#flavour-carousel .relative.width');
      var carousel = function () { return window.paulsCarousels && window.paulsCarousels['flavour-carousel']; };
      var resume = false;   // only restart the carousel if it was moving when a card opened
      var autoScroll = function (on) {
        var c = carousel(), a = c && c.Components && c.Components.AutoScroll;
        if (!a) return;
        if (!on) { if (!a.isPaused()) { resume = true; a.pause(); } }
        else if (resume) { resume = false; a.play(); }
      };

      function setOpen(card, open, focusAfter) {
        var front = card.querySelector('.flavours-div:not(.back)');
        var back = card.querySelector('.flavours-div.back');
        card.classList.toggle('is-open', open);
        front.setAttribute('aria-expanded', open ? 'true' : 'false');
        back.setAttribute('aria-hidden', open ? 'false' : 'true');
        back.inert = !open;
        if (focusAfter) (open ? back.querySelector('.close-icon') : front).focus({ preventScroll: true });
      }
      function closeAll(except) {
        document.querySelectorAll('#flavour-carousel .flavour-card.is-open').forEach(function (c) {
          if (c !== except) setOpen(c, false, false);
        });
      }
      function toggle(card, focusAfter) {
        var open = !card.classList.contains('is-open');
        closeAll(card);
        setOpen(card, open, focusAfter);
        autoScroll(!open);   // hold the carousel still while a card is open
      }
      function onKey(e, fn) {
        if (e.key === 'Enter' || e.key === ' ' || e.key === 'Spacebar') { e.preventDefault(); fn(); }
      }

      cards.forEach(function (card, i) {
        var front = card.querySelector('.flavours-div:not(.back)');
        var back = card.querySelector('.flavours-div.back');
        if (!front || !back) return;
        card.classList.add('flavour-card');
        back.setAttribute('aria-hidden', 'true');
        back.inert = true;
        if (!back.querySelector('.inner-div')) { card.classList.add('no-details'); return; }

        var name = (front.textContent || '').trim();
        back.id = 'flavour-details-' + i;
        front.setAttribute('role', 'button');
        front.setAttribute('tabindex', '0');
        front.setAttribute('aria-expanded', 'false');
        front.setAttribute('aria-controls', back.id);
        front.setAttribute('aria-label', name + ': ingredients and allergens');
        front.addEventListener('click', function () { toggle(card, false); });
        front.addEventListener('keydown', function (e) { onKey(e, function () { toggle(card, true); }); });

        var close = back.querySelector('.close-icon');
        if (close) {
          close.setAttribute('role', 'button');
          close.setAttribute('tabindex', '0');
          close.setAttribute('aria-label', 'Close ' + name + ' details');
          close.addEventListener('click', function () { toggle(card, false); });
          close.addEventListener('keydown', function (e) { onKey(e, function () { toggle(card, true); }); });
        }
        back.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') { e.preventDefault(); toggle(card, true); }
        });
      });
    });
  </script>

</Base>
